{
  "name": "pdf-a11y",
  "version": "0.2.1",
  "description": "Accessibility checker for generated PDFs. Verifies tag tree, alt text, language, table headers and reading structure so PDFs from pdfkit or puppeteer are usable by a screen reader.",
  "keywords": [
    "pdf",
    "accessibility",
    "a11y",
    "pdf-ua",
    "tagged-pdf",
    "wcag",
    "european-accessibility-act",
    "pdfkit",
    "puppeteer",
    "alt-text"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pdf-a11y": "dist/cli.js"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:check": "publint && attw --pack .",
    "bench": "node --expose-gc bench/run.mjs",
    "bench:analyse": "node bench/analyse.mjs .bench-current/analyse.mjs",
    "bench:cli": "node bench/cli.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run package:check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Kacy Tran (https://github.com/kacytran1122)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kacytran1122/pdf-a11y.git"
  },
  "bugs": {
    "url": "https://github.com/kacytran1122/pdf-a11y/issues"
  },
  "homepage": "https://github.com/kacytran1122/pdf-a11y#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
