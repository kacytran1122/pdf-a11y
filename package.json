{
  "name": "pdf-a11y",
  "version": "0.1.0",
  "description": "Accessibility checker for generated PDFs. Verifies tag tree, alt text, language, table headers and reading structure so PDFs from pdfkit or puppeteer are usable by a screen reader.",
  "keywords": ["pdf","accessibility","a11y","pdf-ua","tagged-pdf","wcag","european-accessibility-act","pdfkit","puppeteer","alt-text"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "pdf-a11y": "./dist/cli.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": { "pdf-lib": "^1.17.1" },
  "devDependencies": { "@types/node": "^22.0.0", "tsup": "^8.0.0", "typescript": "^5.5.0", "vitest": "^2.0.0" },
  "engines": { "node": ">=18" }
}
