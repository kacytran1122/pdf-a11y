{
  "name": "pdf-a11y",
  "version": "0.1.0",
  "description": "Accessibility checker for generated PDFs. Verifies tag tree, alt text, language, table headers and reading structure so PDFs from pdfkit or puppeteer are usable by a screen reader.",
  "keywords": [
    "pdf",
    "accessibility",
    "a11y",
    "pdf-ua",
    "tagged-pdf",
    "wcag",
    "european-accessibility-act",
    "pdfkit",
    "puppeteer",
    "alt-text"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pdf-a11y": "dist/cli.js"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "lint:self": "npm run typecheck && npm test"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Kacy Tran (https://github.com/kacytran1122)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kacytran1122/pdf-a11y.git"
  },
  "bugs": {
    "url": "https://github.com/kacytran1122/pdf-a11y/issues"
  },
  "homepage": "https://github.com/kacytran1122/pdf-a11y#readme",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
